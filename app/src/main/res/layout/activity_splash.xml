<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.activities.splash.SplashActivity">


    <VideoView
        android:id="@+id/videoViewSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />


    <LinearLayout
        android:id="@+id/layoutTopButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:alpha="0"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Settings -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/kids_secondary"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/white" />

        </androidx.cardview.widget.CardView>

        <!-- Rate -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnRate"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/kids_accent"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:contentDescription="Rate Us"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="@color/text_dark" />

        </androidx.cardview.widget.CardView>

        <!-- Share -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnShare"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/paint_blue"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:contentDescription="Share App"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/white" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/appNameCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:alpha="0"
        app:cardBackgroundColor="#EFFFFFFF"
        app:cardCornerRadius="@dimen/_18sdp"
        app:cardElevation="@dimen/_8sdp"
        app:strokeColor="@color/kids_accent"
        app:strokeWidth="@dimen/_2sdp"
        app:layout_constraintBottom_toTopOf="@id/btnPlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_18sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_18sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/kids_accent"
            android:textSize="@dimen/_24ssp"
            android:textStyle="bold|italic"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="5" />

    </com.google.android.material.card.MaterialCardView>


    <!-- Play Button -->
    <FrameLayout
        android:id="@+id/btnPlay"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginBottom="@dimen/_28sdp"
        android:alpha="0"
        android:background="@drawable/bg_play_button_yellow"
        android:clickable="true"
        android:elevation="@dimen/_8sdp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/text_dark" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>