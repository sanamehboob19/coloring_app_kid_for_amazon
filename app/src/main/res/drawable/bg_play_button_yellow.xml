<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🟡 PRESSED STATE (Depressed effect) -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow layer -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#F57F17" />
                </shape>
            </item>
            <!-- Top Yellow Face (Pushed down by 4dp) -->
            <item android:top="6dp">
                <shape android:shape="oval">
                    <solid android:color="#FFD600" />
                    <stroke android:width="4dp" android:color="#FFF9C4" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- 🟡 NORMAL STATE (Elevated 3D with bottom shadow) -->
    <item>
        <layer-list>
            <!-- Dark Gold Bottom 3D Shadow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#F57F17" />
                </shape>
            </item>
            <!-- Top Vibrant Yellow Face (Elevated with shadow visible below) -->
            <item android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="#FFEA00" />
                    <stroke android:width="4dp" android:color="#FFFDE7" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>