<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Vibrant 3D top banner gradient using your brand colors -->
    <gradient
        android:angle="90"
        android:startColor="@color/kids_primary_dark"
        android:centerColor="@color/kids_primary"
        android:endColor="@color/kids_accent" />

    <corners android:radius="@dimen/_22sdp" />

    <stroke
        android:width="@dimen/_3sdp"
        android:color="@color/white" />

    <padding
        android:left="@dimen/_4sdp"
        android:top="@dimen/_4sdp"
        android:right="@dimen/_4sdp"
        android:bottom="@dimen/_4sdp" />
</shape>