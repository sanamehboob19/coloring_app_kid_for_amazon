<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="@dimen/_10sdp">

    <!-- 🎛️ LEFT SIDE PANEL: Controls, Tools & Palette Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLeftSidePanel"
        android:layout_width="@dimen/_240sdp"
        android:layout_height="0dp"
        android:background="#161622"
        android:padding="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Header Row: Close Button & Title/Colors -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 📺 TV Remote Focusable Close Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnClose"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#232333"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="@dimen/_6sdp"
                app:strokeColor="#4E4E6A"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Exit"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- DONE Button -->
            <TextView
                android:id="@+id/btnFinish"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_finish_gold"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="DONE! ⭐"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

        <!-- Vertical or Horizontal Color Swatches Bar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColors"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/layoutTopHeader"
            tools:listitem="@layout/item_color_swatch" />

        <!-- Drawing Tools -->
        <LinearLayout
            android:id="@+id/layoutTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@+id/rvColors">

            <TextView
                android:id="@+id/btnToolGlow"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_glow"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="Glow ✨"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToolEraser"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_eraser"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="Eraser 🧼"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Brush Size Slider Row -->
        <LinearLayout
            android:id="@+id/layoutSliderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/layoutTools">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size ✏️"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderBrushSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stepSize="5.0"
                android:value="25.0"
                android:valueFrom="10.0"
                android:valueTo="80.0"
                app:thumbColor="@color/paint_pink"
                app:trackColorActive="@color/paint_pink"
                app:trackColorInactive="#30FFFFFF" />
        </LinearLayout>

        <!-- Action Bubbles Row: Save, Clear, Undo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutSliderRow">

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_bubble_btn_green"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="Save"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bubble_camera" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_bubble_btn_orange"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="Clear"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bubble_trash" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:background="@drawable/bg_bubble_btn_pink"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="Undo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bubble_undo" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🖼️ RIGHT SIDE: Full Centered Drawing Canvas Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDrawingContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_10sdp"
        app:cardBackgroundColor="@color/black"
        app:cardCornerRadius="@dimen/_20sdp"
        app:cardElevation="@dimen/_8sdp"
        app:strokeColor="#2A2A3C"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layoutLeftSidePanel"
        app:layout_constraintTop_toTopOf="parent">

        <com.nz.coloringgamesforkidsdoodle.drawingkids.painting.customWidgets.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>